<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows a system splash screen: make it match the game. -->
    <style name="Theme.MichysPetSnake" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/game_background</item>
        <item name="android:colorBackground">@color/game_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/game_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
</resources>
